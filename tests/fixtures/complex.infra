# Full-featured service — tests every nested block of a service.
service api {
    image: "myapp:1.0"
    replicas: 3
    port 8080:80

    resources {
        requests: { cpu: 100m, memory: 256Mi }
        limits:   { cpu: 1, memory: 1Gi }
    }

    env {
        MODE: "production"
        DB_URL: from secret "database".url
        LOG_LEVEL: from config "app".log_level
    }

    health http("/health") {
        interval: 10s
        timeout: 5s
        retries: 3
    }

    volumes {
        data: { mountPath: "/data", claim: "data-pvc" }
    }

    labels: { app: "api", tier: "backend" }
    strategy: rolling
    security {
        user: 1000
        readOnlyRootFilesystem: true
    }
}
