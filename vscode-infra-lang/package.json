{
  "name": "infra-lang",
  "displayName": "Infra Lang",
  "description": "Syntax highlighting, snippets, and language server for .infra files",
  "version": "0.9.0",
  "publisher": "infra-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TuviDev/infra-lang.git"
  },
  "homepage": "https://TuviDev.github.io/infra-lang/",
  "bugs": {
    "url": "https://github.com/TuviDev/infra-lang/issues"
  },
  "keywords": [
    "infra",
    "infrastructure",
    "kubernetes",
    "docker-compose",
    "devops",
    "lsp"
  ],
  "icon": "icon.png",
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:infra"
  ],
  "contributes": {
    "languages": [
      {
        "id": "infra",
        "aliases": [
          "Infra",
          "infra-lang"
        ],
        "extensions": [
          ".infra"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "infra",
        "scopeName": "source.infra",
        "path": "./syntaxes/infra.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "infra",
        "path": "./snippets/infra.json"
      }
    ],
    "configuration": {
      "title": "Infra Lang",
      "properties": {
        "infra.codelens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show FinOps CodeLens badges (cost, replicas, warnings, grades) above service/database/environment blocks."
        },
        "infra.codelens.showCost": {
          "type": "boolean",
          "default": true,
          "description": "Include the monthly cost estimate in CodeLens badges."
        },
        "infra.codelens.showSecurity": {
          "type": "boolean",
          "default": true,
          "description": "Include the security warning count in CodeLens badges."
        },
        "infra.codelens.showReliability": {
          "type": "boolean",
          "default": true,
          "description": "Include reliability grades/findings in CodeLens badges."
        },
        "infra.codelens.emoji": {
          "type": "string",
          "enum": [
            "auto",
            "true",
            "false"
          ],
          "default": "auto",
          "description": "Emoji labels in CodeLens badges ('auto' follows the locale; 'false' forces ASCII-safe labels like [$], [R], [!], [G:A])."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish:marketplace": "vsce publish",
    "publish:openvsx": "ovsx publish"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^2.30.0",
    "ovsx": "^1.1.0",
    "typescript": "^5.0.0"
  }
}
