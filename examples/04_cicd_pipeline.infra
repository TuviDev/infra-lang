# Example 04 — A CI/CD pipeline
# A pipeline compiles to a GitHub Actions workflow (and dependabot config).
# Note: this file targets GitHub Actions only and produces no Kubernetes
# output — that is expected.
#   infra compile examples/04_cicd_pipeline.infra --target github

pipeline main-ci {
    trigger {
      branches: [main, develop]
    }
    stages {
      test: {
        runsOn: ubuntu-latest
        steps {
          checkout: { uses: "checkout" }
          install: { run: "pip install -e .[test]" }
          test: { run: "pytest --cov" }
          lint: { run: "ruff check src/" }
        }
      }
      build: {
        runsOn: ubuntu-latest
        needs: [test]
        steps {
          checkout: { uses: "checkout" }
          build: { run: "docker build -t myapp:latest ." }
          push: { run: "docker push myapp:latest" }
        }
      }
      deploy: {
        runsOn: ubuntu-latest
        needs: [build]
        steps {
          checkout: { uses: "checkout" }
          deploy: { run: "kubectl apply -f k8s/" }
        }
      }
    }
}
