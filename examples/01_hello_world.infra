# Example 01 — Hello world
# The simplest possible service: a single web container with a health check.
# Compile to Kubernetes:
#   infra compile examples/01_hello_world.infra --target kubernetes
# This produces one Deployment and one Service.

service hello {
    image: "nginx:1.25.3"
    port 80
    resources {
      requests: {cpu: 50m, memory: 64Mi}
      limits: {cpu: 200m, memory: 128Mi}
    }
    health http("/")
}
